              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
        },
        "word_count": {
          "type": "integer"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      },
      "required": [
        "title",
        "text",
        "word_count",
        "sections"
      ],
      "additionalProperties": false
