{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fresh-eyes-review results",
  "description": "One run of fresh-eyes-review. Every output format is rendered from this file. See references/output-spec.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "document",
    "inputs",
    "analysis",
    "assumptions",
    "personas",
    "persona_reviews",
    "ai_reader",
    "synthesis",
    "quality",
    "prompts"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "content_hash": {
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "type": "string"
        },
        "execution": {
          "type": "string",
          "enum": [
            "isolated",
            "single",
            "baseline"
          ]
        },
        "condition": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "A",
                "B",
                "C",
                "D",
                "E"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "fast",
            "guided"
          ]
        },
        "platform": {
          "type": "string"
        },
        "usage": {
          "type": "object",
          "properties": {
            "calls": {
              "type": "integer"
            },
            "input_tokens": {
              "type": "integer"
            },
            "output_tokens": {
              "type": "integer"
            },
            "cache_read_input_tokens": {
              "type": "integer"
            },
            "cache_creation_input_tokens": {
              "type": "integer"
            },
            "estimated_cost_usd": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "calls",
            "input_tokens",
            "output_tokens",
            "cache_read_input_tokens",
            "cache_creation_input_tokens",
            "estimated_cost_usd"
          ],
          "additionalProperties": false
        },
        "duration_seconds": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "created_at",
        "tool_version",
        "content_hash",
        "git_commit",
        "model",
        "execution",
        "condition",
        "mode",
        "platform",
        "usage",
        "duration_seconds"
      ],
      "additionalProperties": false
    },
    "document": {
