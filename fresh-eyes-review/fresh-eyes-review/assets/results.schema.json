          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "audience": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "background": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/background_item"
          }
        },
        "persona_overrides": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "house_settings": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "goal",
        "audience",
        "background",
        "persona_overrides",
        "house_settings"
      ],
      "additionalProperties": false
    },
    "analysis": {
      "type": "object",
      "properties": {
        "document_type": {
          "type": "string"
        },
        "doc_type_entry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "author_side": {
          "type": "string"
        },
        "ask": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "deadline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "goal": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "enum": [
                "stated",
                "inferred"
              ]
            }
          },
          "required": [
            "text",
            "source"
          ],
          "additionalProperties": false
        },
        "primary_readers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secondary_readers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "plan_line": {
          "type": "string"
        }
      },
      "required": [
        "document_type",
        "doc_type_entry",
        "stage",
        "author_side",
        "ask",
        "deadline",
        "goal",
        "primary_readers",
        "secondary_readers",
        "plan_line"
      ],
      "additionalProperties": false
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "basis": {
            "type": "string"
          },
          "confirmed": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "text",
          "basis",
          "confirmed"
        ],
        "additionalProperties": false
      }
    },
    "personas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/persona_record"
      }
    },
    "persona_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "persona_id": {
            "type": "string"
          },
          "prompt_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output": {
            "$ref": "#/$defs/persona_review_output"
          }
        },
        "required": [
          "persona_id",
          "prompt_ids",
          "output"
        ],
        "additionalProperties": false
      }
    },
    "ai_reader": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "fresh_context",
                "same_conversation",
                "not_run"
              ]
            },
            "model": {
              "type": "string"
            },
            "recipient": {
              "type": "string"
            },
            "batteries": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "answers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "prompt_id": {
                    "type": "string"
                  },
                  "number": {
                    "type": "integer"
                  },
                  "battery": {
                    "type": "string"
                  },
                  "prompt": {
                    "type": "string"
                  },
                  "answer": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "prompt_id",
                  "number",
                  "battery",
                  "prompt",
                  "answer"
                ],
                "additionalProperties": false
              }
            },
            "survival_check": {
              "anyOf": [
                {
                  "$ref": "#/$defs/survival_check_output"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "method",
            "model",
            "recipient",
            "batteries",
            "answers",
            "survival_check"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "synthesis": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "output": {
              "$ref": "#/$defs/synthesis_output"
            },
            "ranked_issues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "issue_index": {
                    "type": "integer"
                  },
                  "rank": {
                    "type": "integer"
                  },
                  "score": {
                    "type": "number"
                  },
                  "readers": {
                    "type": "integer"
                  },
                  "primary": {
                    "type": "boolean"
                  },
                  "convergent": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "issue_index",
                  "rank",
                  "score",
                  "readers",
                  "primary",
                  "convergent"
                ],
                "additionalProperties": false
              }
            },
            "priority_actions": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "reader_specific": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "persona_id": {
                    "type": "string"
                  },
                  "finding_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "persona_id",
                  "finding_refs"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "output",
            "ranked_issues",
            "priority_actions",
            "reader_specific"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "quality": {
      "type": "object",
      "properties": {
        "anchoring": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer"
            },
            "verified": {
              "type": "integer"
            },
            "rate": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "unverified": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "finding_ref": {
                    "type": "string"
                  },
                  "quote": {
                    "type": "string"
                  }
                },
                "required": [
                  "finding_ref",
                  "quote"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "total",
            "verified",
            "rate",
            "unverified"
          ],
          "additionalProperties": false
        },
        "distinctiveness": {
          "type": "object",
          "properties": {
            "pairs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "a": {
                    "type": "string"
                  },
                  "b": {
                    "type": "string"
                  },
                  "overlap": {
                    "type": "number"
                  }
                },
                "required": [
                  "a",
                  "b",
                  "overlap"
                ],
                "additionalProperties": false
              }
            },
            "flagged": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "a": {
                    "type": "string"
                  },
                  "b": {
                    "type": "string"
                  },
                  "overlap": {
                    "type": "number"
                  }
                },
                "required": [
                  "a",
                  "b",
                  "overlap"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "pairs",
            "flagged"
          ],
          "additionalProperties": false
        },
        "stance_spread": {
          "type": "object",
          "properties": {
            "personas": {
              "type": "integer"
            },
            "distinct_actions": {
              "type": "integer"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "personas",
            "distinct_actions",
            "note"
          ],
          "additionalProperties": false
        },
        "assumption_load": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer"
            },
            "key": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "count",
            "key"
          ],
          "additionalProperties": false
        },
        "coverage": {
          "type": "object",
          "properties": {
            "unassessed_look_for": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "persona_id": {
                    "type": "string"
                  },
                  "item": {
                    "type": "string"
                  }
                },
                "required": [
                  "persona_id",
                  "item"
                ],
                "additionalProperties": false
              }
            },
            "attention_gaps": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "section_id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "readers": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "section_id",
                  "label",
                  "readers"
                ],
                "additionalProperties": false
              }
            },
            "review_gaps": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "section_id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "section_id",
                  "label"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "unassessed_look_for",
            "attention_gaps",
            "review_gaps"
          ],
          "additionalProperties": false
        },
        "leaks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "finding_ref": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "finding_ref",
              "note"
            ],
            "additionalProperties": false
          }
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "anchoring",
        "distinctiveness",
        "stance_spread",
        "assumption_load",
        "coverage",
        "leaks",
        "caveats"
      ],
      "additionalProperties": false
    },
    "prompts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prompt_record"
      }
    }
  },
  "$defs": {
    "look_for_check": {
      "type": "object",
      "properties": {
        "item": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "clear",
            "unclear_or_buried",
            "missing",
            "not_applicable"
          ]
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "item",
        "status",
        "quote",
        "note"
      ],
      "additionalProperties": false,
      "description": "One item from the persona's 'What they look for' section."
    },
    "finding": {
      "type": "object",
      "properties": {
        "quote": {
          "type": "string"
        },
        "issue": {
          "type": "string"
        },
        "why_it_matters": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      },
      "required": [
        "quote",
        "issue",
        "why_it_matters",
        "severity",
        "confidence"
      ],
      "additionalProperties": false,
      "description": "A single anchored finding. quote must be verbatim from the document."
    },
    "passage_note": {
      "type": "object",
      "properties": {
        "quote": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "quote",
        "note"
      ],
      "additionalProperties": false
    },
    "attention_entry": {
      "type": "object",
      "properties": {
        "section_id": {
          "type": "string"
        },
        "attention": {
          "type": "string",
          "enum": [
            "read_closely",
            "skimmed",
            "skipped"
          ]
        },
        "would_miss": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "section_id",
        "attention",
        "would_miss"
      ],
      "additionalProperties": false
    },
    "persona_review_output": {
      "type": "object",
      "properties": {
        "main_point": {
          "type": "string"
        },
        "gut_reaction": {
          "type": "string"
        },
        "likely_next_action": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string"
            },
            "driver": {
              "type": "string"
            }
          },
          "required": [
            "action",
            "driver"
          ],
          "additionalProperties": false
        },
        "look_for": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/look_for_check"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "what_works": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/passage_note"
          }
        },
        "attention_map": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attention_entry"
          }
        }
      },
      "required": [
        "main_point",
        "gut_reaction",
        "likely_next_action",
        "look_for",
        "findings",
        "what_works",
        "attention_map"
      ],
      "additionalProperties": false,
      "description": "What each persona returns. See references/persona-review-format.md."
    },
    "survival_check_output": {
      "type": "object",
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "check": {
                "type": "string",
                "enum": [
                  "ask",
                  "deadline",
                  "leverage",
                  "characterization",
                  "advice"
                ]
              },
              "result": {
                "type": "string",
                "enum": [
                  "yes",
                  "partly",
                  "no",
                  "not_applicable"
                ]
              },
              "document_quote": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ai_quote": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "prompt_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "check",
              "result",
              "document_quote",
              "ai_quote",
              "prompt_ids",
              "note"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "checks"
      ],
      "additionalProperties": false,
      "description": "AI-reader survival check. See references/ai-reader-prompts.md."
    },
    "synthesis_output": {
      "type": "object",
      "properties": {
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "quote": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "finding_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "reader": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "reader",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              },
              "severity": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "category": {
                "type": "string",
                "enum": [
                  "finding",
                  "main_point_mismatch",
                  "survival_failure",
                  "attention_gap"
                ]
              },
              "depends_on_assumptions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "fix_direction": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "quote",
              "summary",
              "finding_refs",
              "reasons",
              "severity",
              "category",
              "depends_on_assumptions",
              "fix_direction"
            ],
            "additionalProperties": false
          }
        },
        "dropped_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "finding_ref": {
                "type": "string"
              },
              "rule": {
                "type": "string",
                "enum": [
                  "no_anchor",
                  "no_goal_link",
                  "substance",
                  "out_of_lane",
                  "leaked_knowledge"
                ]
              },
