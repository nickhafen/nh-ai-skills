{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scholarly-draft-review results",
  "description": "One run of scholarly-draft-review. Every output format is rendered from this file. See references/output-spec.md. Generated by extras/build/build_schema.py; don't edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "document",
    "inputs",
    "analysis",
    "assumptions",
    "personas",
    "persona_reviews",
    "related_work_check",
    "key_sentence_check",
    "synthesis",
    "quality"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "content_hash": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "created_at",
        "tool_version",
        "content_hash",
        "model",
        "platform"
      ],
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "working_copy": {
          "type": "string"
        },
        "word_count": {
          "type": "integer"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "key_sentences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key_sentence"
          }
        }
      },
      "required": [
        "title",
        "source_file",
        "working_copy",
        "word_count",
        "sections",
        "key_sentences"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "properties": {
        "intended_claim": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "stage": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "idea",
                "early",
                "full",
                "workshop",
                "submission"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "venue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "feedback_wanted": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "known_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prior_feedback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "persona_overrides": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "house_settings": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "intended_claim",
        "stage",
        "venue",
        "feedback_wanted",
        "known_gaps",
        "prior_feedback",
        "persona_overrides",
        "house_settings"
      ],
      "additionalProperties": false
    },
    "analysis": {
      "type": "object",
      "properties": {
        "piece_type": {
          "type": "string"
        },
        "stage": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "enum": [
                "idea",
                "early",
                "full",
                "workshop",
                "submission"
              ]
            },
            "source": {
              "type": "string",
              "enum": [
                "stated",
                "inferred"
              ]
            },
            "basis": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "source",
            "basis"
          ],
          "additionalProperties": false
        },
        "venue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "field": {
          "type": "string"
        },
        "prescriptive": {
          "type": "boolean"
        },
        "claim": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "enum": [
                "stated",
                "inferred"
              ]
            }
          },
          "required": [
            "text",
            "source"
          ],
          "additionalProperties": false
        },
        "stage_focus": {
          "type": "string"
        },
        "plan_line": {
          "type": "string"
        }
      },
      "required": [
        "piece_type",
        "stage",
        "venue",
        "field",
        "prescriptive",
        "claim",
        "stage_focus",
        "plan_line"
      ],
      "additionalProperties": false
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "basis": {
            "type": "string"
          },
          "confirmed": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "text",
          "basis",
          "confirmed"
        ],
        "additionalProperties": false
      }
    },
    "personas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/persona_record"
      }
    },
    "persona_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "persona_id": {
            "type": "string"
          },
          "output": {
            "$ref": "#/$defs/persona_review_output"
          }
        },
        "required": [
          "persona_id",
          "output"
        ],
        "additionalProperties": false
      }
    },
    "related_work_check": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "searched",
                "not_run"
              ]
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ref": {
                    "type": "string"
                  },
                  "work": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "verified",
                      "cited_in_draft",
                      "not_found",
                      "not_checked"
                    ]
                  },
                  "url": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "required": [
                  "ref",
                  "work",
                  "status",
                  "url",
                  "note"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "method",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "key_sentence_check": {
      "anyOf": [
        {
          "$ref": "#/$defs/key_sentence_output"
        },
        {
          "type": "null"
        }
      ]
    },
    "synthesis": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "output": {
              "$ref": "#/$defs/synthesis_output"
            },
            "ranked_issues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "issue_index": {
                    "type": "integer"
                  },
                  "rank": {
                    "type": "integer"
                  },
                  "score": {
                    "type": "number"
                  },
                  "readers": {
                    "type": "integer"
                  },
                  "convergent": {
                    "type": "boolean"
                  },
                  "timing": {
                    "type": "string",
                    "enum": [
                      "now",
                      "later"
                    ]
                  }
                },
                "required": [
                  "issue_index",
                  "rank",
                  "score",
                  "readers",
                  "convergent",
                  "timing"
                ],
                "additionalProperties": false
              }
            },
            "priority_actions": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "parked": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          },
          "required": [
            "output",
            "ranked_issues",
            "priority_actions",
            "parked"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "quality": {
      "type": "object",
      "properties": {
        "anchoring": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer"
            },
            "verified": {
              "type": "integer"
            },
            "unverified": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "finding_ref": {
                    "type": "string"
                  },
                  "quote": {
                    "type": "string"
                  }
                },
                "required": [
                  "finding_ref",
                  "quote"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "total",
            "verified",
            "unverified"
          ],
          "additionalProperties": false
        },
        "related_work": {
          "type": "object",
          "properties": {
            "specific": {
              "type": "integer"
            },
            "verified": {
              "type": "integer"
            },
            "cited_in_draft": {
              "type": "integer"
            },
            "not_found": {
              "type": "integer"
            },
            "not_checked": {
              "type": "integer"
            }
          },
          "required": [
            "specific",
            "verified",
            "cited_in_draft",
            "not_found",
            "not_checked"
          ],
          "additionalProperties": false
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "scope": {
                "type": "string",
                "enum": [
                  "standing",
                  "run"
                ]
              }
            },
            "required": [
              "title",
              "text",
              "scope"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "anchoring",
        "related_work",
        "limitations"
      ],
      "additionalProperties": false
    }
  },
  "$defs": {
    "look_for_check": {
      "type": "object",
      "properties": {
        "item": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "clear",
            "unclear_or_buried",
            "missing",
            "not_applicable"
          ]
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "item",
        "status",
        "quote",
        "note"
      ],
      "additionalProperties": false,
      "description": "One item from the persona's 'What they look for' section."
    },
    "finding": {
      "type": "object",
      "properties": {
        "quote": {
          "type": "string"
        },
        "issue": {
          "type": "string"
        },
        "why_it_matters": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      },
      "required": [
        "quote",
        "issue",
        "why_it_matters",
        "severity"
      ],
      "additionalProperties": false,
      "description": "A single anchored finding. quote must be verbatim from the draft."
    },
    "passage_note": {
      "type": "object",
      "properties": {
        "quote": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "quote",
        "note"
      ],
      "additionalProperties": false
    },
    "related_work_item": {
      "type": "object",
      "properties": {
        "work": {
          "type": "string"
        },
        "specific": {
          "type": "boolean"
        },
        "why": {
          "type": "string"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      },
      "required": [
        "work",
        "specific",
        "why",
        "confidence"
      ],
      "additionalProperties": false,
      "description": "A work or kind of work a reader points to. specific=true names a particular work, author, or case."
    },
    "persona_review_output": {
      "type": "object",
      "properties": {
        "main_point": {
          "type": "string"
        },
        "look_for": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/look_for_check"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "what_works": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/passage_note"
          }
        },
        "related_work": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/related_work_item"
          }
        }
      },
      "required": [
        "main_point",
        "look_for",
        "findings",
        "what_works",
        "related_work"
      ],
      "additionalProperties": false,
      "description": "What each reader returns. See references/persona-review-format.md."
    },
    "key_sentence_output": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string"
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "paragraph_id": {
                "type": "string"
              },
              "quote": {
                "type": "string"
              },
              "issue": {
                "type": "string"
              }
            },
            "required": [
              "paragraph_id",
              "quote",
              "issue"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "verdict",
        "flags"
      ],
      "additionalProperties": false,
      "description": "The key-sentence check. See SKILL.md step 6."
    },
    "synthesis_output": {
      "type": "object",
      "properties": {
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "quote": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "finding_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "reader": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "reader",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              },
              "severity": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "category": {
                "type": "string",
                "enum": [
                  "finding",
                  "claim_mismatch",
                  "key_sentence"
                ]
              },
              "timing": {
                "type": "string",
                "enum": [
                  "now",
                  "later"
                ]
              },
              "direction": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "quote",
              "summary",
              "finding_refs",
              "reasons",
              "severity",
              "category",
              "timing",
              "direction"
            ],
            "additionalProperties": false
          }
        },
        "dropped_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "finding_ref": {
                "type": "string"
              },
              "rule": {
                "type": "string",
                "enum": [
                  "no_anchor",
                  "no_goal_link",
                  "substance",
                  "unverified_source",
                  "out_of_lane",
                  "known_gap",
                  "leaked_knowledge"
                ]
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "finding_ref",
              "rule",
              "note"
            ],
            "additionalProperties": false
          }
        },
        "tradeoffs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "quote": {
                "type": "string"
              },
              "sides": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "reader": {
                      "type": "string"
                    },
                    "wants": {
                      "type": "string"
                    },
                    "why": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "reader",
                    "wants",
                    "why"
                  ],
                  "additionalProperties": false
                }
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "quote",
              "sides",
              "note"
            ],
            "additionalProperties": false
          }
        },
        "whats_working": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "quote": {
                "type": "string"
              },
              "readers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "quote",
              "readers",
              "note"
            ],
            "additionalProperties": false
          }
        },
        "feedback_plan": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "who": {
                "type": "string"
              },
              "when": {
                "type": "string",
                "enum": [
                  "now",
                  "next_draft",
                  "before_submission"
                ]
              },
              "ask": {
                "type": "string"
              },
              "why": {
                "type": "string"
              }
            },
            "required": [
              "who",
              "when",
              "ask",
              "why"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "issues",
        "dropped_findings",
        "tradeoffs",
        "whats_working",
        "feedback_plan"
      ],
      "additionalProperties": false,
      "description": "What the synthesis writes. See references/synthesis-rubric.md."
    },
    "section": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "key_sentence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "section_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "section_id",
        "text"
      ],
      "additionalProperties": false
    },
    "persona_record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "reader_type": {
          "type": "string",
          "enum": [
            "nonexpert",
            "expert",
            "Expert",
            "gatekeeper",
            "custom"
          ]
        },
        "briefing": {
          "type": "string",
          "enum": [
            "briefed",
            "cold"
          ]
        },
        "adaptations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "parameter": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "parameter",
              "value",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "added_context": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "adapted_text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "reader_type",
        "briefing",
        "adaptations",
        "added_context",
        "adapted_text"
      ],
      "additionalProperties": false,
      "description": "A reader as adapted for this run."
    }
  }
}
